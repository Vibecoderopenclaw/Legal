{
  "name": "legal-chatbot",
  "version": "1.0.0",
  "description": "AI-powered legal chatbot for M&A, Private Equity, and Litigation professionals",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "client:dev": "vite",
    "server:dev": "node --watch server/index.js",
    "build": "vite build",
    "start": "node server/index.js",
    "lint": "eslint src/ server/",
    "preview": "vite preview"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "uuid": "^9.0.0",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.0",
    "react-markdown": "^9.0.1",
    "lucide-react": "^0.344.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "vite": "^5.1.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.56.0"
  }
}
